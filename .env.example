# Copy this file to .env and fill in what you have. Every value is optional —
# the pipeline is fail-soft: a source with no key (or that errors out) is
# skipped and the run continues with the remaining sources at reduced coverage.

# Cloudflare Radar (free tier, API token required)
# https://developers.cloudflare.com/radar/get-started/first-request/
CLOUDFLARE_API_TOKEN=

# ACLED (free with registration) — https://acleddata.com/register/
ACLED_API_KEY=
ACLED_EMAIL=

# Optional: local CSV/URL export of the Access Now #KeepItOn shutdown list.
# Access Now does not publish a stable public API for this dataset, so point
# this at a CSV you exported yourself (from https://www.accessnow.org/keepiton/
# or the STOP data) or leave blank to skip shutdown attribution.
KEEPITON_CSV_PATH=

# Semantic gap-filling layer (Phase 3) — both required to enable it
SERPER_API_KEY=
GROQ_API_KEY=

# Nominatim requires no key but ask that you set a real contact per their
# usage policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=shutdown-radar/1.0 (contact: you@example.com)

# Rolling window (days) fetched on each Phase 1 run
LOOKBACK_DAYS=14
